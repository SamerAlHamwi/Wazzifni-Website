#!/usr/bin/env bash
set -e

rm -rf /var/www/Wazzifni-Website

GITHUB_USERNAME="SamerAlHamwi"
GITHUB_TOKEN="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" 
BRANCH="main"  # Fixed: removed extra quote

# Use HTTPS with token for authentication
REPO="https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GITHUB_USERNAME}/Wazzifni-Website.git"
APP_DIR="/var/www/Wazzifni-Website"
CONTAINER_NAME="wazzifni-website"
IMAGE_NAME="wazzifni-website-image"
PORT=8090

echo "== Cloning or updating project from $BRANCH branch =="

if [ -d "$APP_DIR" ]; then
    cd "$APP_DIR"
    git fetch origin
    git checkout "$BRANCH"
    git pull origin "$BRANCH"
else
    git clone -b "$BRANCH" "$REPO" "$APP_DIR"
    cd "$APP_DIR"
    # Remove token from remote URL for security after clone
    git remote set-url origin "https://github.com/${GITHUB_USERNAME}/Wazzifni-Website.git"
fi

echo "== Stop Old Docker image =="
docker compose down

echo "== Building Docker image =="
docker compose build --no-cache  # Fixed: changed from docker-compose to docker compose for consistency

echo "== Running container on port $PORT =="
docker compose up -d

echo "== Done =="
echo "App running on port $PORT"  